# How these patterns work:
# - A pattern with no slash, apart from a trailing one, matches at any depth,
#   so "bin/" covers tinyshop/src/product-service/bin/. "**/" is redundant there.
# - A trailing "/" matches directories only.
# - "!" re-includes a path, but only if its parent directory isn't excluded as a whole.
# - The last matching rule wins, so negations go after the rule they override.
# Debug with: git check-ignore -v <path>

# --------------------------------------------------------------------------
# Secrets and local configuration
# Real values stay on each machine; *.example files (committed) document them.
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
appsettings.Local.json
secrets/
*.secret

# Deliberately NOT ignored (committed on purpose):
#   appsettings.json, appsettings.Development.json: non-secret defaults
#   Properties/launchSettings.json: local run profiles, no secrets

# --------------------------------------------------------------------------
# TLS material (epic M1.5)
# Certificates and keys are generated by a script, never committed.
# If a public certificate ever needs to be committed, re-include it with "!".
# --------------------------------------------------------------------------
*.key
*.pem
*.crt
*.csr
*.srl
*.pfx
*.p12

# --------------------------------------------------------------------------
# .NET
# --------------------------------------------------------------------------
bin/
obj/
artifacts/
publish/
*.binlog
*.nupkg
*.snupkg
*.pubxml.user

# Tests and coverage
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml
BenchmarkDotNet.Artifacts/

# --------------------------------------------------------------------------
# Node / React (Vite)
# --------------------------------------------------------------------------
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------------------------------------
# Python (helper scripts, if any appear)
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# --------------------------------------------------------------------------
# Docker and runtime data
# Prefer named volumes. If a container ever needs a bind-mounted data
# directory (Postgres, Prometheus, Loki, Tempo, Grafana), put it under .data/
# --------------------------------------------------------------------------
.data/

# --------------------------------------------------------------------------
# Logs and temporary files
# --------------------------------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak
*.swp
*~

# --------------------------------------------------------------------------
# Editors and tools
# --------------------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.suo
*.rsuser

# JetBrains Rider
.idea/
*.DotSettings.user

# VS Code: ignore everything except settings worth sharing.
# Must be ".vscode/*", not ".vscode/", or the negations below can't apply.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/

# Claude Code: shared settings are committed, personal ones are not
.claude/settings.local.json

# --------------------------------------------------------------------------
# OS clutter
# --------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
