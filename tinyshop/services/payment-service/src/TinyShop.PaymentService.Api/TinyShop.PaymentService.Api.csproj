<!--
  Api: the gRPC layer and the composition root. Implements the PaymentService contract
  (tinyshop/proto) and talks only to Application interfaces.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TinyShop.PaymentService.Application\TinyShop.PaymentService.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contract is referenced from tinyshop/proto, never copied: one copy, checked by buf in CI.
         ProtoRoot makes import paths match buf's module root.
         Grpc.Tools generates C# at build time (obj/), so generated code is never committed.
         "Both": the server base class for this service, plus the client the integration tests use.
         Other services generate their own client from the same .proto; they never reference this project. -->
    <Protobuf Include="..\..\..\..\proto\tinyshop\payment\v1\payment.proto"
              ProtoRoot="..\..\..\..\proto"
              GrpcServices="Both"
              Link="Protos\payment.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyShop.PaymentService.UnitTests" />
  </ItemGroup>

</Project>
