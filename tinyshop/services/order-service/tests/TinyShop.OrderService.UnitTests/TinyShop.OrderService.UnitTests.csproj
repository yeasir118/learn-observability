<!--
  Fast tests for logic in every layer. No database, no network, no running server: dependencies
  are substitutes (NSubstitute), stub HTTP handlers and a fake gRPC CallInvoker.
  References the Api project, which brings in all other layers.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables that run on Microsoft.Testing.Platform
         (enabled for "dotnet test" in global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyShop.OrderService.Api\TinyShop.OrderService.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
