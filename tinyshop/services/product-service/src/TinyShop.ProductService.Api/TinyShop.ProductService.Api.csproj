<!--
  Api: the HTTP layer and the composition root. Controllers talk only to Application interfaces.
  The reference to Infrastructure exists only so Program.cs can register its implementations.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- XML doc comments on controllers become descriptions in the OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. Only public API surface that matters gets documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>845b1c61-96f3-4920-add6-560b1c2cc727</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyShop.ProductService.Application\TinyShop.ProductService.Application.csproj" />
    <ProjectReference Include="..\TinyShop.ProductService.Infrastructure\TinyShop.ProductService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyShop.ProductService.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Needed by "dotnet ef" at design time (migrations); never shipped as a runtime dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
