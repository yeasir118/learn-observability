<!--
  Application: use cases. Defines the interfaces it needs (such as repositories)
  and leaves their implementation to Infrastructure.
  References only Domain.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TinyShop.ProductService.Domain\TinyShop.ProductService.Domain.csproj" />
    <!-- DataStoreUnavailableException (D25). Dependency-free, so Application stays free of
         web and database code. -->
    <ProjectReference Include="..\..\..\..\shared\TinyShop.ServiceDefaults.Abstractions\TinyShop.ServiceDefaults.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Service implementations are internal; the unit tests may still construct them directly. -->
    <InternalsVisibleTo Include="TinyShop.ProductService.UnitTests" />
  </ItemGroup>

</Project>
