# Environment for running the product-service image by hand with "docker run".
#
#   Copy to .env (git-ignored) and replace every <placeholder>:
#     cp .env.example .env
#   Username and password must match PRODUCT_DB_USER / PRODUCT_DB_PASSWORD in
#   infrastructure/compose/.env, the values product-db was initialised with.
#
#   Prerequisite, from infrastructure/compose/:
#     docker compose --profile debug up -d
#
# Inside a container, "localhost" is the container itself, so the database is addressed by
# its Docker DNS name, on the port it listens on INSIDE Docker (5432), never 5433 (that's
# the proxy's port on the host).

# Optional: enables Swagger at /swagger. Without it, the app runs as Production.
ASPNETCORE_ENVIRONMENT=Development


# --- Option A: through the debug proxy -------------------------------------------------
# The container joins tinyshop_debug-network (not internal, so -p publishes the port) and
# reaches the database via product-db-proxy, which forwards to product-db.
#
#   docker run -d --name product-service --network tinyshop_debug-network `
#     -p 8080:8080 --env-file .env tinyshop-productservice
#
ConnectionStrings__ProductDb=Host=product-db-proxy;Port=5432;Database=tinyshop_products;Username=<user>;Password=<password>


# --- Option B: directly on the database's network --------------------------------------
# The container starts on a non-internal network (so -p publishes the port), then also joins
# tinyshop_product-network (internal) to reach product-db directly, without the proxy.
# Comment out Option A and uncomment this line.
#
#   docker run -d --name product-service --network tinyshop_debug-network `
#     -p 8080:8080 --env-file .env tinyshop-productservice
#   docker network connect tinyshop_product-network product-service
#
# ConnectionStrings__ProductDb=Host=product-db;Port=5432;Database=tinyshop_products;Username=<user>;Password=<password>
