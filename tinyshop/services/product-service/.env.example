# Assumes that the container is connected to the same network as the product-db-proxy
#
# Running this command creates the container in that network
# Since this is not an internal network, application is reachable from the host machine at http://localhost:8080 and the container can reach the database at product-db-proxy:5432 which forwards to the database at product-db:5432 in tinyshop_product-network network
#
# docker run -d -p 8080:8080 --name product-service --network tinyshop_debug-network --env-file ..\..\services\product-service\.env tinyshop-productservice
ConnectionStrings__ProductDb=Host=product-db-proxy;Port=5432;Database=tinyshop_products;Username=tinyshop;Password=tinyshop

# Assumes that the container is connected to the same network as the product-db
# 
# Running these commands creates the container in that network
# The container is in tinyshop_debug-network and is thus reachable from the host machine at http://localhost:8080 since this is not an internal network
# The container can reach the database directly(without the proxy) since it is in the same network as the database at product-db:5432
# 
# docker run -d -p 8080:8080 --name product-service --network tinyshop_debug-network --env-file ..\..\services\product-service\.env tinyshop-productservice
# docker network connect tinyshop_product-network product-service 
#ConnectionStrings__ProductDb=Host=product-db;Port=5432;Database=tinyshop_products;Username=tinyshop;Password=tinyshop
