# Template for .env, which Compose reads from this folder for ${VAR} substitution
# in compose.yaml. Copy it and set real values:
#   cp .env.example .env
# .env is git-ignored. Every variable compose.yaml uses must be listed here.
#
# Passwords take effect only when a database volume is first created. After changing one,
# recreate that database's volume (docker compose down -v), or change it inside Postgres too.

# --- product-db -----------------------------------------------------------------------------
# Three roles, one job each (architecture.md §10, "Database roles"). Role names are fixed in
# compose.yaml; only the passwords are configuration.

# Superuser "postgres": initialises the database, then is used by nothing else.
PRODUCT_DB_ADMIN_PASSWORD=change-me-admin
# "product_migrator": owns the schema, used only by the product-db-migrate job.
PRODUCT_DB_MIGRATOR_PASSWORD=change-me-migrator
# "product_app": read-only access, used by product-service.
PRODUCT_DB_APP_PASSWORD=change-me-app

# --- user-db --------------------------------------------------------------------------------
# Same three roles: "postgres", "user_migrator" (user-db-migrate job), "user_app" (user-service).
USER_DB_ADMIN_PASSWORD=change-me-admin
USER_DB_MIGRATOR_PASSWORD=change-me-migrator
USER_DB_APP_PASSWORD=change-me-app
