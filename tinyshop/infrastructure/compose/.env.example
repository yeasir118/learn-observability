# Template for .env, which Compose reads from this folder for ${VAR} substitution
# in compose.yaml. Copy it and set real values:
#   cp .env.example .env
# .env is git-ignored. Every variable compose.yaml uses must be listed here.
#
# Passwords take effect only when a database volume is first created. After changing one,
# recreate that database's volume (docker compose down -v), or change it inside Postgres too.

# --- product-db -----------------------------------------------------------------------------
# Three roles, one job each (architecture.md §10, "Database roles"). Role names are fixed in
# compose.yaml; only the passwords are configuration.

# Superuser "postgres": initialises the database, then is used by nothing else.
PRODUCT_DB_ADMIN_PASSWORD=change-me-admin
# "product_migrator": owns the schema, used only by the product-db-migrate job.
PRODUCT_DB_MIGRATOR_PASSWORD=change-me-migrator
# "product_app": read-only access, used by product-service.
PRODUCT_DB_APP_PASSWORD=change-me-app

# --- user-db --------------------------------------------------------------------------------
# Same three roles: "postgres", "user_migrator" (user-db-migrate job), "user_app" (user-service).
USER_DB_ADMIN_PASSWORD=change-me-admin
USER_DB_MIGRATOR_PASSWORD=change-me-migrator
USER_DB_APP_PASSWORD=change-me-app

# --- order-db -------------------------------------------------------------------------------
# Same three roles: "postgres", "order_migrator" (order-db-migrate job), "order_app"
# (order-service; the only app role that writes: SELECT, INSERT, UPDATE).
ORDER_DB_ADMIN_PASSWORD=change-me-admin
ORDER_DB_MIGRATOR_PASSWORD=change-me-migrator
ORDER_DB_APP_PASSWORD=change-me-app

# --- Fault switches (TS-016) ----------------------------------------------------------------
# Failures on purpose, for the exercises. All off here; tinyshop/docs/faults.md explains each one
# and lists the settings per exercise. Change a value, then "docker compose up -d": only the
# affected service is recreated, no image is rebuilt. Each service logs a Warning at startup for
# every fault that's on. Rates are 0 to 1; delays are hh:mm:ss (fractions allowed: 00:00:00.500),
# at most 00:01:00 for payments and 00:00:25 for the database.
# An empty ID means "everyone".

# product-service: a share of product requests fail with 500 (optionally only one product ID).
PRODUCT_SERVICE_FAULT_ERROR_RATE=0
PRODUCT_SERVICE_FAULT_PRODUCT_ID=

# payment-service: slower payments, declines ("card_declined"), technical errors (502 for the
# order), optionally only for one user ID. DECLINE_RATE + ERROR_RATE may not exceed 1.
PAYMENT_SERVICE_FAULT_DELAY=00:00:00
PAYMENT_SERVICE_FAULT_DECLINE_RATE=0
PAYMENT_SERVICE_FAULT_ERROR_RATE=0
PAYMENT_SERVICE_FAULT_USER_ID=

# Every database command of that service waits this long in Postgres.
PRODUCT_SERVICE_FAULT_DATABASE_DELAY=00:00:00
USER_SERVICE_FAULT_DATABASE_DELAY=00:00:00
ORDER_SERVICE_FAULT_DATABASE_DELAY=00:00:00

# --- Load generator (TS-017) ----------------------------------------------------------------
# Used only by "docker compose --profile load up load-generator" (tinyshop/infrastructure/load/README.md).
# Iterations per second: one journey each (browse, look up a user, order, ...).
LOAD_GENERATOR_RATE=10
# How long one run lasts: k6 durations, e.g. 30s, 5m, 1h. Runs of a few seconds write no report.
LOAD_GENERATOR_DURATION=30s
