# Template for .env, which Compose reads from this folder for ${VAR} substitution
# in compose.yaml. Copy it and set real values:
#   cp .env.example .env
# .env is git-ignored. Every variable compose.yaml uses must be listed here.

# --- product-db ---------------------------------------------------------------
# Owner of the tinyshop_products database. product-service connects as this user.
PRODUCT_DB_USER=product_service
# Password for PRODUCT_DB_USER. Use your own value in .env.
PRODUCT_DB_PASSWORD=change-me
