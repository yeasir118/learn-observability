# Let git detect which files are text, store them with LF in the repository, and check them out
# with LF on every machine, overriding core.autocrlf. That keeps git consistent with
# tinyshop/.editorconfig (end_of_line = lf); otherwise Windows checkouts get CRLF and
# "dotnet format --verify-no-changes" fails locally while passing in CI.
* text=auto eol=lf

# Anything executed inside a Linux container must be checked out with LF,
# whatever the machine's settings are: a CRLF breaks the shebang line.
*.sh text eol=lf

# Windows batch files are the reverse: cmd.exe needs CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
